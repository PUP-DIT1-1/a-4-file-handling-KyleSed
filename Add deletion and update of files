import java.io.*;
import java.util.*;
public class Main {
    static final String FILE_NAME = "C:\\Users\\Administrator\\Desktop\\students.csv";
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        ArrayList<String[]> students = new ArrayList<>();
        ArrayList<int[]> grades = new ArrayList<>();
        loadFromFile(students, grades);
        int option =0;
        do {
            System.out.println("\nStudents Grade Collection System");
            System.out.println("""
                    Options:
                    1. Add Student Record
                    2. View All Records
                    3. Search Student
                    4. Average of Student
                    5. Update Student Record
                    6. Delete Student Record
                    7. Exit
                    """);
            System.out.print("Choose option: ");
            try {
                option = scan.nextInt();
                scan.nextLine();
            } catch (Exception e) {
                System.out.println("Invalid input.");
                scan.nextLine();
                continue;
            }
            switch (option) {
                case 1:
                    addStudent(scan,students,grades);
                    saveToFile(students,grades);
                    break;
                case 2:
                    displayAll(students,grades);
                    break;
                case 3:
                    System.out.print("Enter name: ");
                    searchStudent(students,scan.nextLine());
                    break;
                case 4:
                    System.out.print("Enter name: ");
                    computeAverage(students,grades,scan.nextLine());
                    break;
                case 5:
                    updateRecord(scan,students,grades);
                    saveToFile(students,grades);
                    break;
                case 6:
                    deleteRecord(scan,students,grades);
                    saveToFile(students,grades);
                    break;
                case 7:
                    System.out.println(""" 
                            Thanks for using this record system. 
                            Have a wonderful day ahead!
                            """);
                    break;
                default:
                    System.out.println("Invalid option.");
            }
        }while (option != 7);
    }
    public static void addStudent(Scanner scan, ArrayList<String[]> students, ArrayList<int[]> grades) {
        try {
            System.out.print("First Name: ");
            String first = scan.nextLine();
            System.out.print("Last Name: ");
            String last = scan.nextLine();
            int[] g = new int[4];
            System.out.print("English: ");
            g[0] = scan.nextInt();
            System.out.print("Filipino: ");
            g[1] = scan.nextInt();
            System.out.print("Math: ");
            g[2] = scan.nextInt();
            System.out.print("Science: ");
            g[3] = scan.nextInt();
            scan.nextLine();
            students.add(new String[]{first, last});
            grades.add(g);
            System.out.println("Student added!");
        } catch (Exception e) {
            System.out.println("Invalid input.");
            scan.nextLine();
        }
    }
    public static void updateRecord(Scanner scan, ArrayList<String[]> students, ArrayList<int[]> grades) {
        if (students.isEmpty()) {
            System.out.println("No records available.");
            return;
        }
        displayAll(students, grades);
        try {
            System.out.print("Enter index to update: ");
            int index = scan.nextInt();
            scan.nextLine();
            if (index < 0 || index >= students.size()) {
                System.out.println("Invalid index.");
                return;
            }
            System.out.print("New First Name: ");
            students.get(index)[0] = scan.nextLine();
            System.out.print("New Last Name: ");
            students.get(index)[1] = scan.nextLine();
            int[] g = grades.get(index);
            System.out.print("New English: ");
            g[0] = scan.nextInt();
            System.out.print("New Filipino: ");
            g[1] = scan.nextInt();
            System.out.print("New Math: ");
            g[2] = scan.nextInt();
            System.out.print("New Science: ");
            g[3] = scan.nextInt();
            scan.nextLine();
            System.out.println("Record updated!");
        } catch (Exception e) {
            System.out.println("Invalid input.");
            scan.nextLine();
        }
    }
    public static void deleteRecord(Scanner scan, ArrayList<String[]> students, ArrayList<int[]> grades) {
        if (students.isEmpty()) {
            System.out.println("No records available.");
            return;
        }
        displayAll(students, grades);
        try {
            System.out.print("Enter index to delete: ");
            int index = scan.nextInt();
            scan.nextLine();
            if (index < 0 || index >= students.size()) {
                System.out.println("Invalid index.");
                return;
            }
            students.remove(index);
            grades.remove(index);
            System.out.println("Record deleted!");
        } catch (Exception e) {
            System.out.println("Invalid input.");
            scan.nextLine();
        }
    }
    public static void saveToFile(ArrayList<String[]> students, ArrayList<int[]> grades) {
        try (BufferedWriter writer = new BufferedWriter(new FileWriter(FILE_NAME))) {
            for (int i = 0; i < students.size(); i++) {
                String[] s = students.get(i);
                int[] g = grades.get(i);
                writer.write(s[0] + "," + s[1] + "," +
                        g[0] + "," + g[1] + "," + g[2] + "," + g[3]);
                writer.newLine();
            }
        } catch (IOException e) {
            System.out.println("Error saving file.");
        }
    }
    public static void loadFromFile(ArrayList<String[]> students, ArrayList<int[]> grades) {
        File file = new File(FILE_NAME);
        try {
            if (!file.exists()) {
                file.createNewFile();
                return;
            }
            BufferedReader reader = new BufferedReader(new FileReader(file));
            String line;
            while ((line = reader.readLine()) != null) {
                String[] data = line.split(",");
                if (data.length == 6) {
                    students.add(new String[]{data[0], data[1]});
                    int[] g = new int[4];
                    for (int i = 0; i < 4; i++) {
                        g[i] = Integer.parseInt(data[i + 2]);
                    }
                    grades.add(g);
                }
            }
            reader.close();
        } catch (Exception e) {
            System.out.println("Error loading file.");
        }
    }
    public static void displayAll(ArrayList<String[]> students, ArrayList<int[]> grades) {
        for (int i = 0; i < students.size(); i++) {
            String[] s = students.get(i);
            int[] g = grades.get(i);
            System.out.println("Index: " + i);
            System.out.println("Name: " + s[0] + " " + s[1]);
            System.out.println("Grades: " +
                    " English: " + g[0] +
                    " Filipino: " + g[1] +
                    " Math: " + g[2] +
                    " Science: " + g[3]);
            System.out.println();
        }
    }
    public static void searchStudent(ArrayList<String[]> students, String name) {
        boolean found = false;
        for (String[] s : students) {
            if (s[0].equalsIgnoreCase(name) || s[1].equalsIgnoreCase(name)) {
                System.out.println("Found: " + s[0] + " " + s[1]);
                found = true;
            }
        }
        if (!found) {
            System.out.println("Student not found.");
        }
    }
    public static void computeAverage(ArrayList<String[]> students, ArrayList<int[]> grades, String name) {
        for (int i = 0; i < students.size(); i++) {
            String[] s = students.get(i);
            if (s[0].equalsIgnoreCase(name) || s[1].equalsIgnoreCase(name)) {
                int[] g = grades.get(i);
                int avg = (g[0] + g[1] + g[2] + g[3]) / 4;
                System.out.println("Name: " + s[0] + " " + s[1]);
                System.out.println("Average: " + avg);
                return;
            }
        }
        System.out.println("Student not found.");
    }
}
